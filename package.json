{
  "name": "convolens",
  "version": "0.1.0",
  "private": true,
  "description": "ConvoLens - See Your Conversations Clearly. AI-powered conversation analysis platform.",
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky install",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:ui": "turbo run test:ui",
    "generate:test-data": "tsx tools/scripts/generators/test-data.ts",
    "organize:tests": "tsx tools/scripts/organize-tests.ts"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "tools": [
      "tools/scripts"
    ]
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.56.1",
    "@types/jest": "^30.0.0",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^20.19.9",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/testing-library__react": "^10.2.0",
    "@types/testing-library__user-event": "^4.1.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-turbo": "^1.12.6",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^6.2.0",
    "fs-extra": "^11.2.0",
    "glob": "^12.0.0",
    "husky": "^9.0.11",
    "inquirer": "^9.2.12",
    "lint-staged": "^15.2.2",
    "minimatch": "^10.2.3",
    "ora": "^7.0.1",
    "postcss": "^8.5.18",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tree-kill": "^1.2.2",
    "tsx": "^4.7.0",
    "turbo": "^2.9.14",
    "typescript": "^5.3.3",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^3.2.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "//": "Security overrides for transitive dependencies flagged by Dependabot. Scoped by major where several majors coexist, so a fix cannot silently cross a breaking boundary. Drop an entry once the parent package ships the patched range itself.",
    "overrides": {
      "@babel/core": "^7.29.6",
      "@tootallnate/once": "^2.0.1",
      "ajv@6": "^6.14.0",
      "basic-ftp": "^5.3.1",
      "body-parser@1": "^1.20.6",
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.3",
      "diff@4": "^4.0.4",
      "engine.io": "^6.6.7",
      "esbuild@^0.27.3": "^0.28.1",
      "flatted": "^3.4.2",
      "glob@10": "^10.5.0",
      "ip-address": "^10.3.1",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.3.0",
      "jws@3": "^3.2.3",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "path-to-regexp@0": "^0.1.13",
      "postcss@8": "^8.5.18",
      "preact": "^10.28.2",
      "qs@6": "^6.15.2",
      "rollup@4": "^4.59.0",
      "sharp": "^0.35.0",
      "socket.io-parser": "^4.2.7",
      "tar@6": "^7.5.21",
      "tar-fs@2": "^2.1.4",
      "tar-fs@3": "^3.1.1",
      "tmp@0": "^0.2.6",
      "uuid@8": "^11.1.1",
      "ws@8": "^8.21.0",
      "yaml@2": "^2.8.3"
    }
  }
}
